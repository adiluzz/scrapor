{
  "Rules": [
    {
      "ID": "sites-large-objects-to-ia",
      "Status": "Enabled",
      "Filter": {
        "And": {
          "Prefix": "sites/",
          "ObjectSizeGreaterThan": 33554432
        }
      },
      "Transitions": [
        {
          "Days": 30,
          "StorageClass": "STANDARD_IA"
        }
      ]
    },
    {
      "ID": "abort-incomplete-multipart",
      "Status": "Enabled",
      "Filter": {
        "Prefix": ""
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 7
      }
    }
  ]
}
